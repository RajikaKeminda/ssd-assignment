# Server
NODE_ENV=development
# On macOS, AirPlay Receiver often uses 5000; use 5001 if the server fails to bind.
PORT=5000

# MongoDB
MONGODB_URI=mongodb://localhost:27017/medication-tracker

# JWT
# SECURITY (see SECURITY.md #3): these MUST be unique, random, >=32-char
# secrets — env.ts now refuses to boot with a short secret or with either of
# the placeholder values that used to ship here. Generate real ones with:
#   openssl rand -hex 32
JWT_ACCESS_SECRET=replace-with-a-unique-64-char-hex-secret-openssl-rand--hex-32
JWT_REFRESH_SECRET=replace-with-a-different-unique-64-char-hex-secret-openssl-rand
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# CORS
CORS_ORIGIN=http://localhost:3000

# Rate Limiting (general API)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Stripe (mock key for development)
STRIPE_SECRET_KEY=sk_test_mock_key

# Google Maps (mock key for development)
GOOGLE_MAPS_API_KEY=mock-google-maps-key

# RxNorm API (use 'mock' for built-in mock data, or the real URL below)
# RXNORM_API_BASE_URL=https://rxnav.nlm.nih.gov/REST
RXNORM_API_BASE_URL=mock
