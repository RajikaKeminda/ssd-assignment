# Base URL of the backend API.
VITE_API_URL=http://localhost:4000/api

# New feature: Sign in with Google (OAuth 2.0 / OpenID Connect Authorization
# Code grant — see SECURITY.md "New Feature: Sign in with Google").
#
# VITE_GOOGLE_CLIENT_ID must match the backend's GOOGLE_CLIENT_ID (both
# identify the same OAuth client registered in Google Cloud Console). It is
# safe to expose in frontend code — it is a public identifier, not a secret.
# Leave it unset to hide the "Sign in with Google" button entirely.
VITE_GOOGLE_CLIENT_ID=

# Must exactly match one of the "Authorized redirect URIs" configured for
# this OAuth client in Google Cloud Console, and the backend's
# GOOGLE_OAUTH_REDIRECT_URI. If unset, it defaults to
# `${window.location.origin}/oauth/google/callback`.
VITE_GOOGLE_REDIRECT_URI=http://localhost:5173/oauth/google/callback
